// Copy this file to Secrets.xcconfig (same folder) and fill in your own values.
// Secrets.xcconfig is gitignored and must never be committed.
//
// Every key here is OPTIONAL. The app works with public/free-tier defaults
// and degrades gracefully (cached data, or "--") when a key is missing —
// see PriceProvider and TransactionProvider for the fallback behavior.

// CoinGecko API key (optional). Free tier works unauthenticated with lower
// rate limits. Get a Demo key at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY =

// Etherscan-family "V2" unified API key, used for transaction history and
// contract lookups across all EVM networks (Ethereum, Polygon, BSC,
// Arbitrum, Optimism, Base, Avalanche). Get one free at
// https://etherscan.io/apis
EXPLORER_API_KEY =

// Optional custom RPC endpoints (e.g. Infura/Alchemy project URLs) to
// override the public defaults in SupportedEVMNetworks.swift for higher
// reliability. Leave blank to use public RPCs.
ETHEREUM_RPC_URL =
POLYGON_RPC_URL =
